<?xml version="1.0" encoding="UTF-8"?>


<suite name="Suite" parallel="tests" thread-count="2">

	<!-- Test running on Chrome -->
	<test name="ChromeTest">
		<parameter name="browser" value="chrome" />
		<classes>
			<class
				name="com.automation.framework.SeleniumPOMFramework.LoginTest">
				<methods>
					<include name="verifyLogin" />
				</methods>
			</class>

		</classes>
	</test>

	<!-- Test running on Firefox -->
	<test name="FirefoxTest">
		<parameter name="browser" value="firefox" />
		<classes>
			<class
				name="com.automation.framework.SeleniumPOMFramework.LoginTest">
				<methods>
					<include name="verifyLogin" />
					<include name="CreatingBatch" />
				</methods>
			</class>
		</classes>
	</test>

</suite>